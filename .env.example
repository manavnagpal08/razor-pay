# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120
AGENT_API_KEYS=replace_with_random_agent_key

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/razorpay_ai_commerce

# Supabase (for Auth/DB)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_secret
RAZORPAY_WEBHOOK_SECRET=replace_me_webhook_secret

# AI/LLM
GEMINI_API_KEY=your_gemini_api_key
REQUIRE_LIVE_AI=false

# Production Email Delivery (Brevo Transactional Email)
BREVO_API_KEY=xkeysib_replace_me
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=BuyFlow Store

# Auth
JWT_SECRET=replace_with_at_least_32_random_characters

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
